##################################################################################
## ZRtech / WXEDA Pin Constraints for SPC-1000F (from FPGA-FM-Transmitter)
## Target FPGA: Spartan-6 XC6SLX9-TQG144-2
##################################################################################

## 48MHz System Clock (CLK = P56)
NET "clk_50" LOC = P56 | TNM_NET = "sys_clk_pin" | IOSTANDARD = "LVCMOS33";
TIMESPEC "TS_sys_clk_pin" = PERIOD "sys_clk_pin" 48 MHz HIGH 50.00%;

## Reset Button (Active Low, KEY1 / S1 = P16)
NET "reset_n" LOC = P16 | IOSTANDARD = "LVCMOS33";

## VGA Output (RGB565 + HS/VS)
NET "vga_r<4>"   LOC = P51 | IOSTANDARD = "LVCMOS33";
NET "vga_r<3>"   LOC = P50 | IOSTANDARD = "LVCMOS33";
NET "vga_r<2>"   LOC = P48 | IOSTANDARD = "LVCMOS33";
NET "vga_r<1>"   LOC = P47 | IOSTANDARD = "LVCMOS33";
NET "vga_r<0>"   LOC = P46 | IOSTANDARD = "LVCMOS33";

NET "vga_g<5>"   LOC = P45 | IOSTANDARD = "LVCMOS33";
NET "vga_g<4>"   LOC = P44 | IOSTANDARD = "LVCMOS33";
NET "vga_g<3>"   LOC = P43 | IOSTANDARD = "LVCMOS33";
NET "vga_g<2>"   LOC = P41 | IOSTANDARD = "LVCMOS33";
NET "vga_g<1>"   LOC = P40 | IOSTANDARD = "LVCMOS33";
NET "vga_g<0>"   LOC = P35 | IOSTANDARD = "LVCMOS33";

NET "vga_b<4>"   LOC = P34 | IOSTANDARD = "LVCMOS33";
NET "vga_b<3>"   LOC = P33 | IOSTANDARD = "LVCMOS33";
NET "vga_b<2>"   LOC = P32 | IOSTANDARD = "LVCMOS33";
NET "vga_b<1>"   LOC = P30 | IOSTANDARD = "LVCMOS33";
NET "vga_b<0>"   LOC = P29 | IOSTANDARD = "LVCMOS33";

NET "vga_hs"     LOC = P26 | IOSTANDARD = "LVCMOS33";
NET "vga_vs"     LOC = P27 | IOSTANDARD = "LVCMOS33";

## 7-Segment Display (DS_A..DS_DP, DS_EN1..DS_EN4)
NET "seg_data<0>" LOC = P80 | IOSTANDARD = "LVCMOS33";
NET "seg_data<1>" LOC = P79 | IOSTANDARD = "LVCMOS33";
NET "seg_data<2>" LOC = P83 | IOSTANDARD = "LVCMOS33";
NET "seg_data<3>" LOC = P82 | IOSTANDARD = "LVCMOS33";
NET "seg_data<4>" LOC = P81 | IOSTANDARD = "LVCMOS33";
NET "seg_data<5>" LOC = P78 | IOSTANDARD = "LVCMOS33";
NET "seg_data<6>" LOC = P84 | IOSTANDARD = "LVCMOS33";
NET "seg_data<7>" LOC = P85 | IOSTANDARD = "LVCMOS33";

NET "scan_sig<0>" LOC = P66 | IOSTANDARD = "LVCMOS33";
NET "scan_sig<1>" LOC = P74 | IOSTANDARD = "LVCMOS33";
NET "scan_sig<2>" LOC = P67 | IOSTANDARD = "LVCMOS33";
NET "scan_sig<3>" LOC = P75 | IOSTANDARD = "LVCMOS33";
NET "scan_sig<4>" LOC = P94 | IOSTANDARD = "LVCMOS33";
NET "scan_sig<5>" LOC = P95 | IOSTANDARD = "LVCMOS33";

## USB HID Host (Onboard PS2/USB port: PS2_CLK = P24, PS2_DAT = P23)
NET "usbdp"      LOC = P24 | IOSTANDARD = "LVCMOS33" | PULLUP;
NET "usbdm"      LOC = P23 | IOSTANDARD = "LVCMOS33";
